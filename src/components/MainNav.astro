---
interface Props {
	active: "home" | "projects";
}

const { active } = Astro.props;
---

<nav class="main-nav" aria-label="Navegación principal">
	<a class="main-nav__brand" href="/">
		<span class="main-nav__brand-symbol" aria-hidden="true">&gt;_</span>
		<span>Enrique Díaz Vera</span>
	</a>

	<div class="main-nav__links">
		<a
			class:list={["main-nav__link", { "main-nav__link--active": active === "home" }]}
			href="/"
			aria-current={active === "home" ? "page" : undefined}
		>
			Inicio
		</a>

		<a
			class:list={["main-nav__link", { "main-nav__link--active": active === "projects" }]}
			href="/projects"
			aria-current={active === "projects" ? "page" : undefined}
		>
			Proyectos
		</a>
	</div>

	<a
		class="main-nav__download"
		href="/cv/enrique-diaz-vera-cv.pdf"
		download
	>
		Descargar CV ↓
	</a>
</nav>

<style>
	.main-nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		width: min(100%, 96rem);
		margin: 0 auto;
		padding: 0.65rem 1rem;
		background-color: color-mix(in srgb, var(--color-dark) 75%, #000000);
		border: 1px solid color-mix(in srgb, var(--color-white) 18%, transparent);
		border-radius: 1.25rem;
		box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 20%);
	}

	.main-nav__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		justify-self: start;
		color: var(--color-white);
		text-decoration: none;
		white-space: nowrap;
	}

	.main-nav__brand-symbol {
		color: var(--color-green);
		font-size: 1.35rem;
	}

	.main-nav__links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}

	.main-nav__link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.65rem 1.2rem;
		color: var(--color-white);
		text-decoration: none;
		white-space: nowrap;
		border-radius: 0.75rem;
	}

	.main-nav__link--active {
		color: var(--color-dark);
		background: var(--color-green);
	}

	.main-nav__download {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		justify-self: end;
		padding: 0.65rem 1rem;
		color: var(--color-green);
		text-decoration: none;
		white-space: nowrap;
		border: 1px solid var(--color-green);
		border-radius: 0.75rem;
	}

	@media (max-width: 45rem) {
		.main-nav {
			grid-template-columns: 1fr auto;
			min-height: 3.2rem;
			padding: 0.55rem 0.7rem;
			gap: 0.5rem;
		}

		.main-nav__brand {
			display: none;
		}

		.main-nav__links {
			justify-content: flex-start;
			gap: 0.25rem;
		}

		.main-nav__link,
		.main-nav__download {
			padding: 0.55rem 0.7rem;
			font-size: 0.7rem;
		}

		.main-nav__download {
			justify-self: end;
		}
	}
</style>
