---
import Analytics from "@vercel/analytics/astro";
---

<script is:inline>
	const exclusionKey = "portfolio-owner-no-analytics";
	const params = new URLSearchParams(window.location.search);
	const ownerMode = params.get("owner");

	if (ownerMode === "1") {
		localStorage.setItem(exclusionKey, "1");
	}

	if (ownerMode === "0") {
		localStorage.removeItem(exclusionKey);
	}

	if (ownerMode !== null) {
		params.delete("owner");
		const query = params.toString();

		history.replaceState(
			{},
			"",
			`${location.pathname}${query ? `?${query}` : ""}${location.hash}`,
		);
	}

	function webAnalyticsBeforeSend(event) {
		if (localStorage.getItem(exclusionKey) === "1") {
			return null;
		}

		return event;
	}
</script>

<Analytics />