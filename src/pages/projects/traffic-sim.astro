---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MainNav from "../../components/MainNav.astro";

const features = [
    "Red dirigida de carreteras con intersecciones y conexiones validadas.",
    "Planificación de rutas mediante Dijkstra y A*.",
    "Costos de ruta sensibles a la congestión y recálculo dinámico.",
    "Vehículos con aceleración, frenado y seguimiento de tráfico.",
    "Semáforos y controladores de tráfico configurables.",
    "Simulación determinista con paso de tiempo fijo y semillas explícitas.",
    "Generación programada de vehículos mediante escenarios JSON.",
    "Estadísticas de vehículos y carreteras exportables en CSV.",
    "Experimentos parametrizados y ejecución paralela por lotes.",
    "Visualizador interactivo desarrollado con SFML.",
];

const scalability = [
    {
        title: "Optimización algorítmica",
        description:
            "Un índice basado en unordered_map eliminó una búsqueda cuadrática y permite agregar y consultar vehículos en O(1) promedio.",
    },
    {
        title: "Escalabilidad medida",
        description:
            "Duplicar la carga de 5,000 a 10,000 vehículos incrementó el tiempo aproximadamente 2.08 veces.",
    },
    {
        title: "Simulación completa",
        description:
            "Una ejecución con 10,000 vehículos procesó cinco segundos simulados en un promedio de 137.26 ms.",
    },
    {
        title: "Lotes paralelos",
        description:
            "Ocho simulaciones independientes alcanzaron una aceleración de 2.89x utilizando cuatro trabajadores.",
    },
    {
        title: "Concurrencia controlada",
        description:
            "La paralelización se limita a simulaciones independientes para conservar el determinismo de cada ejecución.",
    },
    {
        title: "Benchmarks reproducibles",
        description:
            "GitHub Actions registra compilador, hardware, memoria, tiempo transcurrido y tiempo de CPU.",
    },
    {
        title: "Pruebas automatizadas",
        description:
            "GoogleTest y CTest validan el motor mediante 201 pruebas unitarias y de integración.",
    },
    {
        title: "Portabilidad",
        description:
            "El proyecto se compila mediante CMake con MSVC, GCC y Clang.",
    },
];

const technologies = [
    {
        title: "Motor y algoritmos",
        items: ["C++20", "STL", "RAII", "Dijkstra", "A*", "nlohmann/json"],
    },
    {
        title: "Construcción y calidad",
        items: [
            "CMake",
            "GoogleTest",
            "CTest",
            "clang-format",
            "clang-tidy",
            "Ninja",
        ],
    },
    {
        title: "Visualización e infraestructura",
        items: [
            "SFML 3.1",
            "GitHub Actions",
            "JSON",
            "CSV",
            "MSVC",
            "GCC",
            "Clang",
        ],
    },
];

const security = [
    "Motor principal desacoplado de la consola, los benchmarks y la visualización.",
    "Resultados equivalentes al utilizar el mismo escenario, configuración y semilla.",
    "Semántica por valor y duración automática sin llamadas directas a new o delete.",
    "Identificadores estables para carreteras, intersecciones y vehículos.",
    "Escenarios JSON validados antes de construir la simulación.",
    "Paquetes Release para Windows y Linux con sumas de comprobación SHA-256.",
];
---

<BaseLayout
    title="TrafficSim | Enrique Díaz Vera"
    description="Motor determinista de simulación de tráfico desarrollado en C++20, con rutas, congestión, semáforos y experimentos reproducibles."
>
    <main class="project-page">
        <MainNav active="projects" />

        <article class="project">
            <header class="project-hero">
                <div class="project-hero__content">
                    <p class="project-hero__label">
                        Proyecto de ingeniería en C++20
                    </p>

                    <h1>Traffic<br />Sim</h1>

                    <p class="project-hero__description">
                        Motor determinista de simulación de tráfico que modela
                        redes de carreteras, vehículos, rutas, semáforos y
                        congestión. Incluye experimentos reproducibles,
                        benchmarks y un visualizador interactivo.
                    </p>

                    <p class="project-hero__author">
                        Diseñado y desarrollado completamente por Enrique Díaz
                        Vera.
                    </p>

                    <div class="project-links">
                        <a
                            href="https://github.com/enrique-diazv/traffic-sim"
                            target="_blank"
                            rel="noreferrer"
                        >
                            Ver repositorio
                        </a>

                        <a
                            href="https://github.com/enrique-diazv/traffic-sim/releases/latest"
                            target="_blank"
                            rel="noreferrer"
                        >
                            Descargar versión
                        </a>
                    </div>

                    <ul
                        class="project-stack"
                        aria-label="Tecnologías principales"
                    >
                        <li>C++20</li>
                        <li>CMake</li>
                        <li>SFML</li>
                        <li>GoogleTest</li>
                    </ul>
                </div>

                <div class="project-gallery">
                    <figure class="project-gallery__video">
                        <video
                            controls
                            playsinline
                            preload="metadata"
                            poster="/images/trafficsim/visualizer-overview.png"
                        >
                            <source
                                src="/images/trafficsim/trafficsim-demo.mp4"
                                type="video/mp4"
                            />
                            Tu navegador no puede reproducir este video.
                        </video>

                        <figcaption>
                            Demostración del visualizador interactivo
                        </figcaption>
                    </figure>

                    <figure>
                        <img
                            src="/images/trafficsim/visualizer-overview.png"
                            alt="Red de carreteras representada por el visualizador de TrafficSim"
                            loading="lazy"
                        />
                        <figcaption>
                            Visualizador desarrollado con SFML
                        </figcaption>
                    </figure>

                    <figure>
                        <img
                            src="/images/trafficsim/batch-speedup.svg"
                            alt="Gráfica de aceleración de los lotes paralelos de TrafficSim"
                            loading="lazy"
                        />
                        <figcaption>
                            Aceleración de lotes con cuatro trabajadores
                        </figcaption>
                    </figure>
                </div>
            </header>
            <section class="project-section project-section--features">
                <h2>Funciones</h2>

                <ul class="feature-list">
                    {features.map((feature) => <li>{feature}</li>)}
                </ul>
            </section>

            <section class="project-section project-section--scalability">
                <h2>Rendimiento y calidad</h2>

                <p class="project-section__introduction">
                    TrafficSim fue optimizado a partir de benchmarks
                    reproducibles. Las mediciones permitieron eliminar un cuello
                    de botella cuadrático y evaluar la concurrencia únicamente
                    donde las simulaciones son independientes:
                </p>

                <ul class="feature-list feature-list--detailed">
                    {
                        scalability.map((item) => (
                            <li>
                                <strong>{item.title}:</strong>{" "}
                                {item.description}
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section class="project-section project-section--technologies">
                <h2>Tecnologías</h2>

                <div class="technology-grid">
                    {
                        technologies.map((group) => (
                            <section class="technology-group">
                                <h3>{group.title}</h3>

                                <ul>
                                    {group.items.map((item) => (
                                        <li>{item}</li>
                                    ))}
                                </ul>
                            </section>
                        ))
                    }
                </div>
            </section>

            <section class="project-section project-section--architecture">
                <h2>Arquitectura</h2>

                <div
                    class="architecture-flow"
                    aria-label="Arquitectura principal de TrafficSim"
                >
                    <span>Aplicaciones</span>
                    <b aria-hidden="true">→</b>
                    <span>trafficsim_core</span>
                    <b aria-hidden="true">→</b>
                    <span>Simulation</span>
                    <b aria-hidden="true">→</b>
                    <span>Red, rutas y vehículos</span>
                </div>

                <div class="external-services">
                    <span>Consola</span>
                    <span>Experimentos</span>
                    <span>Visualizador SFML</span>
                    <span>Benchmarks</span>
                    <span>Escenarios JSON</span>
                    <span>Resultados CSV</span>
                </div>
            </section>

            <section class="project-section project-section--security">
                <h2>Decisiones de diseño</h2>

                <ul class="feature-list">
                    {security.map((item) => <li>{item}</li>)}
                </ul>
            </section>

            <a class="back-link" href="/projects"> ← Volver a proyectos </a>
        </article>
    </main>
</BaseLayout>

<style>
    .project-page {
        width: 100%;
        min-height: 100svh;
        padding: clamp(1rem, 2.5vw, 2.5rem);
        background: var(--color-dark);
        color: var(--color-white);
    }

    .project {
        width: min(100%, 87rem);
        margin: clamp(3rem, 7vw, 6rem) auto 0;
    }

    .project-hero {
        display: grid;
        grid-template-columns:
            minmax(20rem, 0.9fr)
            minmax(0, 1.35fr);
        align-items: start;
        gap: clamp(4rem, 6vw, 7rem);
    }

    .project-hero__label {
        width: fit-content;
        margin: 0 0 1.5rem;
        padding: 0.45em 0.75em;
        border-radius: 20px;
        background: var(--color-red);
        color: var(--color-white);
        font-size: 0.75rem;
    }

    .project-hero h1 {
        margin: 0;
        color: var(--color-orange);
        font-size: clamp(2rem, 4vw, 4rem);
        line-height: 1.15;
    }

    .project-hero__description {
        margin: 2rem 0 0;
        padding: 0.8rem 1rem;
        border-radius: 20px;
        background: var(--color-green);
        color: var(--color-dark);
        font-size: clamp(0.75rem, 1vw, 0.95rem);
        line-height: 1.8;
        text-align: justify;
    }

    .project-hero__author {
        margin: 1.25rem 0 0;
        font-size: clamp(0.7rem, 0.9vw, 0.85rem);
        line-height: 1.7;
    }

    .project-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 2rem;
    }

    .project-links a,
    .back-link {
        padding: 0.7rem 1rem;
        border-radius: 20px;
        background: var(--color-orange);
        color: var(--color-dark);
        font-size: 0.75rem;
        text-decoration: none;
    }

    .project-links a:hover,
    .back-link:hover {
        background: var(--color-green);
    }

    .project-gallery {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        width: min(100%, 40rem);
        justify-self: end;
    }

    .project-gallery figure {
        margin: 0;
        padding: 0.65rem;
        border: 3px solid var(--color-green);
        border-radius: 20px;
        background: #121820;
    }

    .project-gallery figure:first-child {
        grid-column: 1 / -1;
    }

    .project-gallery img {
        width: 100%;
        height: auto;
        border-radius: 12px;
    }

    .project-gallery video {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 8px;
    }

    .project-gallery figcaption {
        margin-top: 0.75rem;
        color: var(--color-blue);
        font-size: 0.65rem;
        line-height: 1.4;
        text-align: center;
    }

    .project-section {
        margin-top: clamp(4rem, 8vw, 7rem);
    }

    .project-section > h2 {
        width: fit-content;
        margin: 0 0 2rem;
        padding: 0.25em 0.6em;
        border-radius: 20px;
        background: var(--color-orange);
        color: var(--color-white);
        font-size: clamp(1.3rem, 2vw, 2rem);
        font-weight: 500;
        line-height: 1.2;
    }

    .feature-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.85rem;
        max-width: 70rem;
        margin: 0;
        padding-left: 1.5rem;
        list-style: square;
    }

    .feature-list li {
        padding: 0;
        border-radius: 0;
        background: transparent;
        color: var(--color-white);
        font-size: clamp(0.68rem, 0.85vw, 0.85rem);
        line-height: 1.6;
    }

    .feature-list li::marker {
        color: var(--color-white);
    }

    .project-section__introduction {
        max-width: 70rem;
        margin: 0 0 1.75rem;
        color: var(--color-white);
        font-size: clamp(0.72rem, 0.9vw, 0.9rem);
        line-height: 1.8;
    }

    .feature-list--detailed {
        gap: 1rem;
    }

    .feature-list--detailed li {
        line-height: 1.8;
    }

    .feature-list--detailed strong {
        color: var(--color-orange);
        font-weight: 700;
    }

    .technology-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: clamp(1.5rem, 4vw, 4rem);
    }

    .technology-group h3 {
        width: fit-content;
        margin: 0 0 1rem;
        color: var(--color-orange);
        font-size: clamp(0.85rem, 1vw, 1rem);
    }

    .technology-group ul {
        display: grid;
        gap: 0.7rem;
        margin: 0;
        padding-left: 1.5rem;
        list-style: square;
    }

    .technology-group li {
        padding: 0;
        background: transparent;
        color: var(--color-white);
        font-size: 0.72rem;
        line-height: 1.5;
    }

    .technology-group li::marker {
        color: var(--color-white);
    }

    .architecture-flow {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .architecture-flow span,
    .external-services span {
        padding: 0.8rem 1rem;
        border-radius: 20px;
        background: var(--color-green);
        color: var(--color-dark);
        font-size: 0.75rem;
        text-align: center;
    }

    .architecture-flow b {
        color: var(--color-orange);
        font-size: 1.5rem;
    }

    .external-services {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2rem;
    }

    .external-services span {
        background: var(--color-blue);
    }

    .back-link {
        display: block;
        width: fit-content;
        margin: clamp(4rem, 8vw, 7rem) 0 2rem;
    }

    @media (max-width: 70rem) {
        .project-hero {
            grid-template-columns: 1fr;
        }

        .technology-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
    .project-gallery {
        justify-self: center;
    }
    @media (max-width: 45rem) {
        .project-page {
            padding: 1.25rem;
        }

        .main-nav {
            grid-template-columns: 1fr auto;
            min-height: 3.2rem;
            padding: 0.55rem 0.7rem;
            gap: 0.5rem;
        }

        .project-gallery,
        .feature-list,
        .technology-grid {
            grid-template-columns: 1fr;
        }

        .project-gallery figure:first-child {
            grid-column: auto;
        }

        .architecture-flow {
            flex-direction: column;
        }

        .architecture-flow b {
            transform: rotate(90deg);
        }
    }

    /* Rediseño de navegación y hero */

    .project-page {
        padding: 0.5rem clamp(1rem, 2.5vw, 2.5rem) clamp(1rem, 2.5vw, 2.5rem);
    }

    .main-nav {
        width: min(100%, 96rem);
        margin: 0 auto;
        padding: 0.65rem 1rem;

        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;

        background-color: color-mix(in srgb, var(--color-dark) 75%, #000000);
        border: 1px solid
            color-mix(in srgb, var(--color-white) 18%, transparent);
        border-radius: 1.25rem;
        box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 20%);
    }

    .main-nav__brand {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        justify-self: start;
        color: var(--color-white);
        text-decoration: none;
        white-space: nowrap;
    }

    .main-nav__brand-symbol {
        color: var(--color-green);
        font-size: 1.35rem;
    }

    .main-nav__links {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
    }

    .main-nav__link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.65rem 1.2rem;
        color: var(--color-white);
        text-decoration: none;
        white-space: nowrap;
        border-radius: 0.75rem;
    }

    .main-nav__link--active {
        color: var(--color-dark);
        background: var(--color-green);
    }

    .main-nav__download {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        justify-self: end;
        padding: 0.65rem 1rem;
        color: var(--color-green);
        text-decoration: none;
        white-space: nowrap;
        border: 1px solid var(--color-green);
        border-radius: 0.75rem;
    }

    .project {
        width: min(100%, 96rem);
        margin: clamp(2rem, 4vw, 3.5rem) auto 0;
    }

    .project-hero {
        grid-template-columns:
            minmax(15rem, 0.7fr)
            minmax(0, 1.5fr);
        align-items: start;
        gap: clamp(2rem, 4vw, 4rem);
    }

    .project-hero__label {
        margin-bottom: 1rem;
        padding: 0.35em 0.7em;
        font-size: 0.65rem;
    }

    .project-hero h1 {
        font-size: clamp(2.5rem, 5vw, 5rem);
        line-height: 0.98;
    }

    .project-hero__description {
        margin-top: 1.5rem;
        padding: 1rem;
        color: var(--color-white);
        background: color-mix(in srgb, var(--color-dark) 88%, #000000);
        border: 1px solid var(--color-green);
        border-radius: 12px;
        font-family: Arial, Helvetica, sans-serif;
        line-height: 1.6;
        text-align: left;
    }

    .project-hero__author {
        font-family: Arial, Helvetica, sans-serif;
    }

    .project-links {
        margin-top: 1.5rem;
    }

    .project-links a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.65rem 1rem;
        border-radius: 999px;
    }

    .project-links a::after {
        content: " ↗";
    }

    .project-stack {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin: 1.5rem 0 0;
        padding: 0;
        list-style: none;
    }

    .project-stack li {
        padding: 0.5rem 0.8rem;
        color: var(--color-white);
        font-size: 0.65rem;
        border: 1px solid var(--color-blue);
        border-radius: 999px;
        background: transparent;
    }

    .project-gallery {
        width: 100%;
        gap: 1rem;
    }

    .project-gallery figure {
        position: relative;
        padding: 0.6rem;
        border: 1px solid var(--color-green);
        border-radius: 12px;
        background: color-mix(in srgb, var(--color-dark) 88%, #000000);
    }

    .project-gallery figure:first-child {
        padding-top: 2.25rem;
    }
    @media (min-width: 70.01rem) {
        .project-gallery figure:first-child {
            width: min(100%, 35rem);
            justify-self: center;
        }
    }

    .project-gallery figure:first-child::before {
        content: "●  ●  ●";
        position: absolute;
        top: 0.6rem;
        left: 0.85rem;
        color: var(--color-red);
        font-family: Arial, sans-serif;
        font-size: 0.75rem;
        letter-spacing: 0.15rem;
    }

    .project-gallery img {
        border-radius: 8px;
    }

    @media (max-width: 70rem) {
        .project-hero {
            grid-template-columns: 1fr;
        }

        .project-gallery {
            justify-self: stretch;
        }
    }

    @media (max-width: 45rem) {
        .main-nav {
            grid-template-columns: 1fr auto;
            padding: 0.55rem 0.7rem;
            gap: 0.5rem;
        }

        .main-nav__brand {
            display: none;
        }

        .main-nav__links {
            justify-content: flex-start;
            gap: 0.25rem;
        }

        .main-nav__link,
        .main-nav__download {
            padding: 0.55rem 0.7rem;
            font-size: 0.7rem;
        }

        .main-nav__download {
            justify-self: end;
        }

        .project-gallery {
            grid-template-columns: 1fr;
        }

        .project-gallery figure:first-child {
            grid-column: auto;
        }
    }

    /* Paneles de información del proyecto */

    .project-section {
        margin-top: 2rem;
        padding: clamp(1.25rem, 2.5vw, 2rem);

        border: 1px solid
            color-mix(in srgb, var(--color-white) 16%, transparent);
        border-radius: 14px;

        background: color-mix(in srgb, var(--color-dark) 88%, #000000);

        box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 12%);
    }

    .project-section > h2 {
        display: flex;
        align-items: center;
        gap: 1rem;
        width: 100%;
        margin: 0 0 1.5rem;
        padding: 0;

        border-radius: 0;
        background: transparent;
        color: var(--color-orange);

        font-size: clamp(1.1rem, 1.7vw, 1.6rem);
        font-weight: 500;
        line-height: 1.35;
    }

    .project-section > h2::before {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;

        width: 3rem;
        height: 3rem;

        border: 1px solid var(--color-orange);
        border-radius: 8px;

        color: var(--color-orange);
        font-size: 0.85rem;
        line-height: 1;
    }

    /* Símbolos de cada panel */

    .project-section--features > h2::before {
        content: ">_";
    }

    .project-section--scalability > h2::before {
        content: "|||";
        letter-spacing: 0.1rem;
    }

    .project-section--technologies > h2::before {
        content: "</>";
    }

    .project-section--architecture > h2::before {
        content: "::";
        font-size: 1rem;
    }

    .project-section--security > h2::before {
        content: "*";
        font-size: 1.35rem;
    }

    /* Listas generales */

    .project-section .feature-list {
        max-width: none;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .project-section .feature-list li {
        position: relative;
        padding-left: 1.25rem;
    }

    .project-section .feature-list li::before {
        content: "•";
        position: absolute;
        top: 0;
        left: 0;
        color: var(--color-orange);
        font-weight: 700;
    }

    /* Funciones y Seguridad en dos columnas */

    .project-section--features .feature-list,
    .project-section--security .feature-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: clamp(2rem, 5vw, 5rem);
        row-gap: 0.85rem;
    }

    /* Escalabilidad */

    .project-section__introduction {
        max-width: none;
        margin-bottom: 1.25rem;
