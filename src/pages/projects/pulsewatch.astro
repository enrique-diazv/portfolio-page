---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MainNav from "../../components/MainNav.astro";

const features = [
    "Autenticación con correo y contraseña, access tokens y refresh tokens rotatorios.",
    "Creación, edición y eliminación de monitores HTTP configurables.",
    "Comprobaciones manuales y programadas mediante Celery y Redis.",
    "Intervalos, timeouts, métodos HTTP y códigos de respuesta configurables.",
    "Detección automática de fallos, recuperaciones e incidentes.",
    "Notificaciones con seguimiento de reintentos y envío mediante log o SMTP.",
    "Dashboard actualizado en tiempo real mediante WebSockets autenticados.",
    "Historial paginado, gráficas de latencia y métricas agregadas.",
    "Interfaz responsive para monitores, incidentes, métricas y cuenta.",
];

const scalability = [
    {
        title: "Procesamiento en segundo plano",
        description:
            "Celery ejecuta las comprobaciones programadas fuera del ciclo de petición de la API, evitando bloquear las solicitudes de los usuarios.",
    },
    {
        title: "Estado distribuido con Redis",
        description:
            "Redis funciona como broker, caché, Pub/Sub y almacenamiento temporal para límites de tasa y bloqueos distribuidos.",
    },
    {
        title: "Actualizaciones en tiempo real",
        description:
            "El dashboard recibe cambios mediante WebSockets autenticados sin realizar consultas constantes al servidor.",
    },
    {
        title: "Historial paginado por cursor",
        description:
            "Los registros de comprobaciones se consultan en bloques estables y eficientes, incluso cuando el historial continúa creciendo.",
    },
    {
        title: "Resúmenes en caché",
        description:
            "Las métricas del dashboard se reutilizan desde caché para reducir consultas repetitivas a PostgreSQL.",
    },
    {
        title: "Retención de datos",
        description:
            "Las tareas programadas eliminan registros antiguos y ayudan a controlar el crecimiento de la base de datos.",
    },
    {
        title: "Arquitectura desacoplada",
        description:
            "Frontend, API, PostgreSQL, Redis, workers y scheduler pueden escalar y desplegarse de forma independiente.",
    },
    {
        title: "Calidad automatizada",
        description:
            "GitHub Actions valida lint, formato, pruebas, cobertura, builds, contenedores y flujos end-to-end.",
    },
    {
        title: "Cobertura del backend",
        description:
            "El proyecto exige una cobertura mínima del 90% para las pruebas automatizadas del backend.",
    },
    {
        title: "Pruebas de rendimiento",
        description:
            "Las mediciones locales con k6 alcanzaron un p95 global de 86.39 ms y menos de 15 ms p95 en los endpoints de lectura evaluados.",
    },
];

const technologies = [
    {
        title: "Frontend",
        items: [
            "React 19",
            "TypeScript",
            "Vite",
            "React Router",
            "TanStack Query",
            "React Hook Form",
            "Zod",
            "Recharts",
        ],
    },
    {
        title: "Backend y datos",
        items: [
            "Python 3.13",
            "FastAPI",
            "Pydantic",
            "SQLAlchemy 2",
            "Alembic",
            "HTTPX",
            "PostgreSQL",
            "Redis",
            "Celery",
            "Celery Beat",
        ],
    },
    {
        title: "Calidad e infraestructura",
        items: [
            "Pytest",
            "Vitest",
            "Testing Library",
            "Playwright",
            "k6",
            "Ruff",
            "Oxlint",
            "GitHub Actions",
            "Docker",
            "Nginx",
            "Vercel",
            "Render",
            "Neon",
        ],
    },
];

const security = [
    "Contraseñas protegidas mediante Argon2.",
    "Access tokens JWT de corta duración y refresh tokens rotatorios.",
    "Cookies seguras HTTP-only para proteger las sesiones.",
    "Protección SSRF después de la resolución DNS.",
    "Bloqueo de destinos privados, locales, link-local y multicast.",
    "Tickets WebSocket autenticados y de un solo uso.",
    "Límites de tasa y bloqueos distribuidos mediante Redis.",
    "Validación de entrada mediante Pydantic y Zod.",
];
---

<BaseLayout
    title="PulseWatch | Enrique Díaz Vera"
    description="Plataforma full stack para monitorear sitios web y APIs HTTP, detectar incidentes y visualizar disponibilidad y latencia."
>
    <main class="project-page">
        <MainNav active="projects" />

        <article class="project">
            <header class="project-hero">
                <div class="project-hero__content">
                    <p class="project-hero__label">Proyecto full stack</p>

                    <h1>Pulse<br />Watch</h1>

                    <p class="project-hero__description">
                        Plataforma de monitoreo para sitios web y APIs HTTP.
                        Ejecuta comprobaciones programadas, registra
                        disponibilidad y latencia, detecta incidentes y
                        actualiza su dashboard en tiempo real.
                    </p>

                    <p class="project-hero__author">
                        Diseñado y desarrollado completamente por Enrique Díaz
                        Vera.
                    </p>

                    <div class="project-links">
                        <a
                            href="https://pulsewatch-steel.vercel.app/"
                            target="_blank"
                            rel="noreferrer"
                        >
                            Ver aplicación
                        </a>

                        <a
                            href="https://github.com/enrique-diazv/pulsewatch"
                            target="_blank"
                            rel="noreferrer"
                        >
                            GitHub
                        </a>
                    </div>

                    <ul
                        class="project-stack"
                        aria-label="Tecnologías principales"
                    >
                        <li>React</li>
                        <li>FastAPI</li>
                        <li>Redis</li>
                        <li>Celery</li>
                    </ul>
                </div>

                <div class="project-gallery">
                    <figure>
                        <img
                            src="/images/pulsewatch/landing-page.png"
                            alt="Página principal de PulseWatch"
                        />
                        <figcaption>Plataforma de monitoreo</figcaption>
                    </figure>

                    <figure>
                        <img
                            src="/images/pulsewatch/monitor-operational.png"
                            alt="Monitor operativo de PulseWatch"
                            loading="lazy"
                        />
                        <figcaption>Estado y métricas del monitor</figcaption>
                    </figure>

                    <figure>
                        <img
                            src="/images/pulsewatch/check-history.png"
                            alt="Historial de comprobaciones de PulseWatch"
                            loading="lazy"
                        />
                        <figcaption>
                            Historial de disponibilidad y latencia
                        </figcaption>
                    </figure>
                </div>
            </header>

            <section class="project-section project-section--features">
                <h2>Funciones</h2>

                <ul class="feature-list">
                    {features.map((feature) => <li>{feature}</li>)}
                </ul>
            </section>

            <section class="project-section project-section--scalability">
                <h2>Calidad, escalabilidad y rendimiento</h2>

                <p class="project-section__introduction">
                    PulseWatch combina procesamiento asíncrono, comunicación en
                    tiempo real y validación automatizada para mantener una
                    arquitectura escalable y confiable:
                </p>

                <ul class="feature-list feature-list--detailed">
                    {
                        scalability.map((item) => (
                            <li>
                                <strong>{item.title}:</strong>{" "}
                                {item.description}
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section class="project-section project-section--technologies">
                <h2>Tecnologías</h2>

                <div class="technology-grid">
                    {
                        technologies.map((group) => (
                            <section class="technology-group">
                                <h3>{group.title}</h3>

                                <ul>
                                    {group.items.map((item) => (
                                        <li>{item}</li>
                                    ))}
                                </ul>
                            </section>
                        ))
                    }
                </div>
            </section>

            <section class="project-section project-section--architecture">
                <h2>Arquitectura</h2>

                <div
                    class="architecture-flow"
                    aria-label="Arquitectura de PulseWatch"
                >
                    <span>Navegador</span>
                    <b aria-hidden="true">→</b>
                    <span>React + Vite</span>
                    <b aria-hidden="true">→</b>
                    <span>FastAPI</span>
                    <b aria-hidden="true">→</b>
                    <span>PostgreSQL</span>
                </div>

                <div class="external-services">
                    <span>Redis: broker, caché y Pub/Sub</span>
                    <span>Celery Worker: comprobaciones y notificaciones</span>
                    <span>Celery Beat: programación de tareas</span>
                    <span>WebSocket: actualizaciones en tiempo real</span>
                    <span>Vercel: frontend</span>
                    <span>Render: API y workers</span>
                    <span>Neon: PostgreSQL</span>
                </div>
            </section>

            <section class="project-section project-section--security">
                <h2>Seguridad</h2>

                <ul class="feature-list">
                    {security.map((item) => <li>{item}</li>)}
                </ul>
            </section>

            <a class="back-link" href="/projects"> ← Volver a proyectos </a>
        </article>
    </main>
</BaseLayout>

<style>
    .project-page {
        width: 100%;
        min-height: 100svh;
        padding: clamp(1rem, 2.5vw, 2.5rem);
        background: var(--color-dark);
        color: var(--color-white);
    }

    .project {
        width: min(100%, 87rem);
        margin: clamp(3rem, 7vw, 6rem) auto 0;
    }

    .project-hero {
        display: grid;
        grid-template-columns:
            minmax(20rem, 0.9fr)
            minmax(0, 1.35fr);
        align-items: start;
        gap: clamp(4rem, 6vw, 7rem);
    }

    .project-hero__label {
        width: fit-content;
        margin: 0 0 1.5rem;
        padding: 0.45em 0.75em;
        border-radius: 20px;
        background: var(--color-red);
        color: var(--color-white);
        font-size: 0.75rem;
    }

    .project-hero h1 {
        margin: 0;
        color: var(--color-orange);
        font-size: clamp(2rem, 4vw, 4rem);
        line-height: 1.15;
    }

    .project-hero__description {
        margin: 2rem 0 0;
        padding: 0.8rem 1rem;
        border-radius: 20px;
        background: var(--color-green);
        color: var(--color-dark);
        font-size: clamp(0.75rem, 1vw, 0.95rem);
        line-height: 1.8;
        text-align: justify;
    }

    .project-hero__author {
        margin: 1.25rem 0 0;
        font-size: clamp(0.7rem, 0.9vw, 0.85rem);
        line-height: 1.7;
    }

    .project-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 2rem;
    }

    .project-links a,
    .back-link {
        padding: 0.7rem 1rem;
        border-radius: 20px;
        background: var(--color-orange);
        color: var(--color-dark);
        font-size: 0.75rem;
        text-decoration: none;
    }

    .project-links a:hover,
    .back-link:hover {
        background: var(--color-green);
    }

    .project-gallery {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        width: min(100%, 40rem);
        justify-self: end;
    }

    .project-gallery figure {
        margin: 0;
        padding: 0.65rem;
        border: 3px solid var(--color-green);
        border-radius: 20px;
        background: #121820;
    }

    .project-gallery figure:first-child {
        grid-column: 1 / -1;
    }

    .project-gallery img {
        width: 100%;
        height: auto;
        border-radius: 12px;
    }

    .project-gallery figcaption {
        margin-top: 0.75rem;
        color: var(--color-blue);
        font-size: 0.65rem;
        line-height: 1.4;
        text-align: center;
    }

    .project-section {
        margin-top: clamp(4rem, 8vw, 7rem);
    }

    .project-section > h2 {
        width: fit-content;
        margin: 0 0 2rem;
        padding: 0.25em 0.6em;
        border-radius: 20px;
        background: var(--color-orange);
        color: var(--color-white);
        font-size: clamp(1.3rem, 2vw, 2rem);
        font-weight: 500;
        line-height: 1.2;
    }

    .feature-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.85rem;
        max-width: 70rem;
        margin: 0;
        padding-left: 1.5rem;
        list-style: square;
    }

    .feature-list li {
        padding: 0;
        border-radius: 0;
        background: transparent;
        color: var(--color-white);
        font-size: clamp(0.68rem, 0.85vw, 0.85rem);
        line-height: 1.6;
    }

    .feature-list li::marker {
        color: var(--color-white);
    }

    .project-section__introduction {
        max-width: 70rem;
        margin: 0 0 1.75rem;
        color: var(--color-white);
        font-size: clamp(0.72rem, 0.9vw, 0.9rem);
        line-height: 1.8;
    }

    .feature-list--detailed {
        gap: 1rem;
    }

    .feature-list--detailed li {
        line-height: 1.8;
    }

    .feature-list--detailed strong {
        color: var(--color-orange);
        font-weight: 700;
    }

    .technology-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: clamp(1.5rem, 4vw, 4rem);
    }

    .technology-group h3 {
        width: fit-content;
        margin: 0 0 1rem;
        color: var(--color-orange);
        font-size: clamp(0.85rem, 1vw, 1rem);
    }

    .technology-group ul {
        display: grid;
        gap: 0.7rem;
        margin: 0;
        padding-left: 1.5rem;
        list-style: square;
    }

    .technology-group li {
        padding: 0;
        background: transparent;
        color: var(--color-white);
        font-size: 0.72rem;
        line-height: 1.5;
    }

    .technology-group li::marker {
        color: var(--color-white);
    }

    .architecture-flow {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .architecture-flow span,
    .external-services span {
        padding: 0.8rem 1rem;
        border-radius: 20px;
        background: var(--color-green);
        color: var(--color-dark);
        font-size: 0.75rem;
        text-align: center;
    }

    .architecture-flow b {
        color: var(--color-orange);
        font-size: 1.5rem;
    }

    .external-services {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2rem;
    }

    .external-services span {
        background: var(--color-blue);
    }

    .back-link {
        display: block;
        width: fit-content;
        margin: clamp(4rem, 8vw, 7rem) 0 2rem;
    }

    @media (max-width: 70rem) {
        .project-hero {
            grid-template-columns: 1fr;
        }

        .technology-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
    .project-gallery {
        justify-self: center;
    }
    @media (max-width: 45rem) {
        .project-page {
            padding: 1.25rem;
        }

        .main-nav {
            grid-template-columns: 1fr auto;
            min-height: 3.2rem;
            padding: 0.55rem 0.7rem;
            gap: 0.5rem;
        }

        .project-gallery,
        .feature-list,
        .technology-grid {
            grid-template-columns: 1fr;
        }

        .project-gallery figure:first-child {
            grid-column: auto;
        }

        .architecture-flow {
            flex-direction: column;
        }

        .architecture-flow b {
            transform: rotate(90deg);
        }
    }

    /* Rediseño de navegación y hero */

    .project-page {
        padding: 0.5rem clamp(1rem, 2.5vw, 2.5rem) clamp(1rem, 2.5vw, 2.5rem);
    }

    .main-nav {
        width: min(100%, 96rem);
        margin: 0 auto;
        padding: 0.65rem 1rem;

        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;

        background-color: color-mix(in srgb, var(--color-dark) 75%, #000000);
        border: 1px solid
            color-mix(in srgb, var(--color-white) 18%, transparent);
        border-radius: 1.25rem;
        box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 20%);
    }

    .main-nav__brand {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        justify-self: start;
        color: var(--color-white);
        text-decoration: none;
        white-space: nowrap;
    }

    .main-nav__brand-symbol {
        color: var(--color-green);
        font-size: 1.35rem;
    }

    .main-nav__links {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
    }

    .main-nav__link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.65rem 1.2rem;
        color: var(--color-white);
        text-decoration: none;
        white-space: nowrap;
        border-radius: 0.75rem;
    }

    .main-nav__link--active {
        color: var(--color-dark);
        background: var(--color-green);
    }

    .main-nav__download {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        justify-self: end;
        padding: 0.65rem 1rem;
        color: var(--color-green);
        text-decoration: none;
        white-space: nowrap;
        border: 1px solid var(--color-green);
        border-radius: 0.75rem;
    }

    .project {
        width: min(100%, 96rem);
        margin: clamp(2rem, 4vw, 3.5rem) auto 0;
    }

    .project-hero {
        grid-template-columns:
            minmax(15rem, 0.7fr)
            minmax(0, 1.5fr);
        align-items: start;
        gap: clamp(2rem, 4vw, 4rem);
    }

    .project-hero__label {
        margin-bottom: 1rem;
        padding: 0.35em 0.7em;
        font-size: 0.65rem;
    }

    .project-hero h1 {
        font-size: clamp(2.5rem, 5vw, 5rem);
        line-height: 0.98;
    }

    .project-hero__description {
        margin-top: 1.5rem;
        padding: 1rem;
        color: var(--color-white);
        background: color-mix(in srgb, var(--color-dark) 88%, #000000);
        border: 1px solid var(--color-green);
        border-radius: 12px;
        font-family: Arial, Helvetica, sans-serif;
        line-height: 1.6;
        text-align: left;
    }

    .project-hero__author {
        font-family: Arial, Helvetica, sans-serif;
    }

    .project-links {
        margin-top: 1.5rem;
    }

    .project-links a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.65rem 1rem;
        border-radius: 999px;
    }

    .project-links a::after {
        content: " ↗";
    }

    .project-stack {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin: 1.5rem 0 0;
        padding: 0;
        list-style: none;
    }

    .project-stack li {
        padding: 0.5rem 0.8rem;
        color: var(--color-white);
        font-size: 0.65rem;
        border: 1px solid var(--color-blue);
        border-radius: 999px;
        background: transparent;
    }

    .project-gallery {
        width: 100%;
        gap: 1rem;
    }

    .project-gallery figure {
        position: relative;
        padding: 0.6rem;
        border: 1px solid var(--color-green);
        border-radius: 12px;
        background: color-mix(in srgb, var(--color-dark) 88%, #000000);
    }

    .project-gallery figure:first-child {
        padding-top: 2.25rem;
    }
    @media (min-width: 70.01rem) {
        .project-gallery figure:first-child {
            width: min(100%, 35rem);
            justify-self: center;
        }
    }

    .project-gallery figure:first-child::before {
        content: "●  ●  ●";
        position: absolute;
        top: 0.6rem;
        left: 0.85rem;
        color: var(--color-red);
        font-family: Arial, sans-serif;
        font-size: 0.75rem;
        letter-spacing: 0.15rem;
    }

    .project-gallery img {
        border-radius: 8px;
    }

    @media (max-width: 70rem) {
        .project-hero {
            grid-template-columns: 1fr;
        }

        .project-gallery {
            justify-self: stretch;
        }
    }

    @media (max-width: 45rem) {
        .main-nav {
            grid-template-columns: 1fr auto;
            padding: 0.55rem 0.7rem;
            gap: 0.5rem;
        }

        .main-nav__brand {
            display: none;
        }

        .main-nav__links {
            justify-content: flex-start;
            gap: 0.25rem;
        }

        .main-nav__link,
        .main-nav__download {
            padding: 0.55rem 0.7rem;
            font-size: 0.7rem;
        }

        .main-nav__download {
            justify-self: end;
        }

        .project-gallery {
            grid-template-columns: 1fr;
        }

        .project-gallery figure:first-child {
            grid-column: auto;
        }
    }

    /* Paneles de información del proyecto */

    .project-section {
        margin-top: 2rem;
        padding: clamp(1.25rem, 2.5vw, 2rem);

        border: 1px solid
            color-mix(in srgb, var(--color-white) 16%, transparent);
        border-radius: 14px;

        background: color-mix(in srgb, var(--color-dark) 88%, #000000);

        box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 12%);
    }

    .project-section > h2 {
        display: flex;
        align-items: center;
        gap: 1rem;
        width: 100%;
        margin: 0 0 1.5rem;
        padding: 0;

        border-radius: 0;
        background: transparent;
        color: var(--color-orange);

        font-size: clamp(1.1rem, 1.7vw, 1.6rem);
        font-weight: 500;
        line-height: 1.35;
    }

    .project-section > h2::before {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;

        width: 3rem;
        height: 3rem;

        border: 1px solid var(--color-orange);
        border-radius: 8px;

        color: var(--color-orange);
        font-size: 0.85rem;
        line-height: 1;
    }

    /* Símbolos de cada panel */

    .project-section--features > h2::before {
        content: ">_";
    }

    .project-section--scalability > h2::before {
        content: "|||";
        letter-spacing: 0.1rem;
    }

    .project-section--technologies > h2::before {
        content: "</>";
    }

    .project-section--architecture > h2::before {
        content: "::";
        font-size: 1rem;
    }

    .project-section--security > h2::before {
        content: "*";
        font-size: 1.35rem;
    }

    /* Listas generales */

    .project-section .feature-list {
        max-width: none;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .project-section .feature-list li {
        position: relative;
        padding-left: 1.25rem;
    }

    .project-section .feature-list li::before {
        content: "•";
        position: absolute;
        top: 0;
        left: 0;
        color: var(--color-orange);
        font-weight: 700;
    }

    /* Funciones y Seguridad en dos columnas */

    .project-section--features .feature-list,
    .project-section--security .feature-list {
