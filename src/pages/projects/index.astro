---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MainNav from "../../components/MainNav.astro";
---

<BaseLayout
	title="Proyectos | Enrique Díaz Vera"
	description="Proyectos de desarrollo de software realizados por Enrique Díaz Vera."
>
	<main class="projects-page">
		<MainNav active="projects" />

		<section class="projects-grid" aria-labelledby="projects-title">
			<h1 id="projects-title" class="sr-only">Mis proyectos</h1>

			<a class="project-card" href="/projects/watch-later-universal">
				<span class="folder-icon" aria-hidden="true"></span>

				<h2>
					<span aria-hidden="true">&gt;</span>
					Watch Later Universal
				</h2>

				<p>
					Aplicación full stack para descubrir películas y series,
					consultar sus detalles y guardarlas en una biblioteca
					personal.
				</p>

				<span class="project-card__link">Ver proyecto →</span>
			</a>
			<a class="project-card" href="/projects/pulsewatch">
				<span class="folder-icon" aria-hidden="true"></span>

				<h2>
					<span aria-hidden="true">&gt;</span>
					PulseWatch
				</h2>

				<p>
					Plataforma full stack para monitorear sitios web y APIs
					HTTP, detectar incidentes y visualizar disponibilidad y
					latencia.
				</p>

				<span class="project-card__link">Ver proyecto →</span>
			</a>
			<a class="project-card" href="/projects/traffic-sim">
				<span class="folder-icon" aria-hidden="true"></span>

				<h2>
					<span aria-hidden="true">&gt;</span>
					TrafficSim
				</h2>

				<p>
					Motor determinista de simulación de tráfico desarrollado en
					C++20, con planificación de rutas, congestión, semáforos,
					experimentos reproducibles y visualización interactiva.
				</p>

				<span class="project-card__link">Ver proyecto →</span>
			</a>
		</section>
	</main>
</BaseLayout>

<style>
	.projects-page {
		width: 100%;
		min-height: 100svh;
		padding: 0.5rem clamp(1rem, 2.5vw, 2.5rem) clamp(1rem, 2.5vw, 2.5rem);
		background: var(--color-dark);
		color: var(--color-white);
	}

	.main-nav {
		width: min(100%, 96rem);
		margin: 0 auto;
		padding: 0.65rem 1rem;

		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;

		background-color: color-mix(in srgb, var(--color-dark) 75%, #000000);
		border: 1px solid
			color-mix(in srgb, var(--color-white) 18%, transparent);
		border-radius: 1.25rem;
		box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 20%);
	}

	.main-nav__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		justify-self: start;

		color: var(--color-white);
		text-decoration: none;
		white-space: nowrap;
	}

	.main-nav__brand-symbol {
		color: var(--color-green);
		font-size: 1.35rem;
	}

	.main-nav__links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}

	.main-nav__link {
		display: inline-flex;
		align-items: center;
		justify-content: center;

		padding: 0.65rem 1.2rem;
		color: var(--color-white);
		text-decoration: none;
		white-space: nowrap;
		border-radius: 0.75rem;
	}

	.main-nav__link--active {
		color: var(--color-dark);
		background-color: var(--color-green);
	}

	.main-nav__download {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		justify-self: end;

		padding: 0.65rem 1rem;
		color: var(--color-green);
		text-decoration: none;
		white-space: nowrap;

		border: 1px solid var(--color-green);
		border-radius: 0.75rem;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
		gap: clamp(3rem, 7vw, 6rem);
		width: min(100%, 87rem);
		margin: clamp(4rem, 8vw, 7rem) auto 0;
	}

	.project-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		min-width: 0;
		padding: 1.5rem;
		color: var(--color-white);
		text-align: center;
		text-decoration: none;
	}

	.folder-icon {
		position: relative;
		width: 6rem;
		height: 4rem;
		margin: 1.5rem 0 2rem;
		border: 0.45rem solid var(--color-orange);
		border-radius: 0.2rem 0.5rem 0.5rem;
		transform: skew(-8deg);
	}

	.folder-icon::before {
		content: "";
		position: absolute;
		top: -1.55rem;
		left: -0.45rem;
		width: 2.8rem;
		height: 1.3rem;
		border: 0.45rem solid var(--color-orange);
		border-bottom: 0;
		border-radius: 0.35rem 0.35rem 0 0;
	}

	.project-card h2 {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		margin: 0;
		color: var(--color-white);
		font-size: clamp(0.9rem, 1.2vw, 1.1rem);
		line-height: 1.5;
	}

	.project-card h2 span {
		color: var(--color-orange);
	}

	.project-card p {
		max-width: 28rem;
		margin: 1rem 0 0;
		font-size: clamp(0.7rem, 0.85vw, 0.85rem);
		line-height: 1.7;
	}

	.project-card__link {
		margin-top: 1rem;
		color: var(--color-blue);
		font-size: clamp(0.7rem, 0.85vw, 0.85rem);
	}

	.project-card:hover .folder-icon {
		transform: translateY(-0.5rem) skew(-8deg);
	}

	.project-card:hover .project-card__link {
		color: var(--color-orange);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 45rem) {
		.projects-page {
			padding: 0.5rem 1rem 1rem;
		}

		.main-nav {
			grid-template-columns: 1fr auto;
			min-height: 3.2rem;
			padding: 0.55rem 0.7rem;
			gap: 0.5rem;
		}

		.main-nav__brand {
			display: none;
		}

		.main-nav__links {
			justify-content: flex-start;
			gap: 0.25rem;
		}

		.main-nav__link,
		.main-nav__download {
			padding: 0.55rem 0.7rem;
			font-size: 0.7rem;
		}

		.main-nav__download {
			justify-self: end;
		}

		.projects-grid {
			margin-top: 3rem;
		}
	}
</style>
