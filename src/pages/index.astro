---
import BaseLayout from "../layouts/BaseLayout.astro";
import MainNav from "../components/MainNav.astro";
---

<BaseLayout
	title="Enrique Díaz Vera | Portafolio"
	description="Portafolio de Enrique Díaz Vera, ingeniero en tecnología de software."
>
	<main class="home-page">
		<MainNav active="home" />

		<section class="home-intro">
			<aside class="profile">
				<img
					class="profile__avatar"
					src="/images/IMG_8606.jpg"
					alt="Fotografía de Enrique Díaz Vera"
				/>

				<p class="profile__availability">
					<span aria-hidden="true"></span>
					Disponible para oportunidades laborales
				</p>

				<p class="profile__role">
					Ingeniero en
					<strong>Tecnología de Software</strong>
				</p>

				<p class="profile__location">
					<svg
						class="profile__location-icon"
						viewBox="0 0 24 24"
						fill="none"
						aria-hidden="true"
					>
						<path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"
						></path>
						<circle cx="12" cy="10" r="3"></circle>
					</svg>

					<span>Monterrey, Nuevo León, México</span>
				</p>

				<div class="profile__languages">
					<svg
						class="profile__languages-icon"
						viewBox="0 0 24 24"
						fill="none"
						aria-hidden="true"
					>
						<path d="M8 17H5l-3 3v-9a4 4 0 0 1 4-4h2"></path>
						<path
							d="M9 9a4 4 0 0 1 4-4h5a4 4 0 0 1 4 4v8l-4-3h-5a4 4 0 0 1-4-4Z"
						></path>
					</svg>

					<div class="profile__languages-list">
						<span>Español: Nativo</span>
						<span>Inglés: B2/C1</span>
					</div>
				</div>
			</aside>

			<div class="presentation">
				<div class="presentation__heading">
					<span class="presentation__arrow" aria-hidden="true"></span>

					<h1 class="hello-world">
						<span class="hello-world__message">Hola, </span>
						<span class="hello-world__accent">Mundo</span>
					</h1>
				</div>

				<p class="presentation__description">
					Desarrollador de software con formación en Ingeniería en
					Tecnología de Software por la UANL. Recién he concluido los
					10 semestres del plan de estudio. Cuento con experiencia en
					<strong> desarrollo web</strong>,
					<strong> Quality Assurance</strong> y diseño
					<strong> UX/UI</strong>.
				</p>
			</div>

			<aside class="contact" aria-label="Datos de contacto">
				<a
					class="contact__row"
					href="mailto:ediazvera30@gmail.com"
					aria-label="Enviar correo a Enrique Díaz Vera"
				>
					<span class="contact__icon" aria-hidden="true">@</span>
					<span class="contact__value"> ediazvera30@gmail.com </span>
				</a>

				<a
					class="contact__row"
					href="tel:+529384010427"
					aria-label="Llamar a Enrique Díaz Vera"
				>
					<span
						class="contact__icon contact__icon--phone"
						aria-hidden="true"></span>

					<span class="contact__value"> +52 938 401 0427 </span>
				</a>

				<a
					class="contact__row"
					href="https://www.linkedin.com/in/enrique-d%C3%ADaz-vera"
					target="_blank"
					rel="noreferrer"
				>
					<span
						class="contact__icon contact__icon--linkedin"
						aria-hidden="true"
					>
						in
					</span>

					<span class="contact__value">LinkedIn ↗</span>
				</a>

				<a
					class="contact__row"
					href="https://github.com/enrique-diazv"
					target="_blank"
					rel="noreferrer"
				>
					<svg
						class="contact__icon contact__icon--github"
						viewBox="0 0 24 24"
						fill="currentColor"
						aria-hidden="true"
					>
						<path
							d="M12 .7a11.3 11.3 0 0 0-3.57 22c.57.1.77-.25.77-.55v-2.18c-3.15.68-3.81-1.34-3.81-1.34-.51-1.31-1.26-1.66-1.26-1.66-1.03-.7.08-.69.08-.69 1.14.08 1.74 1.17 1.74 1.17 1.01 1.73 2.65 1.23 3.29.94.1-.73.4-1.23.72-1.51-2.51-.29-5.15-1.26-5.15-5.59 0-1.24.44-2.25 1.17-3.04-.12-.29-.51-1.44.11-3 0 0 .95-.3 3.11 1.16A10.8 10.8 0 0 1 12 6.08c.96 0 1.92.13 2.83.38 2.16-1.46 3.1-1.16 3.1-1.16.63 1.56.24 2.71.12 3 .73.79 1.17 1.8 1.17 3.04 0 4.34-2.65 5.3-5.17 5.58.41.35.77 1.04.77 2.1v3.13c0 .3.2.66.78.55A11.3 11.3 0 0 0 12 .7Z"
						></path>
					</svg>

					<span class="contact__value">GitHub ↗</span>
				</a>
			</aside>
		</section>

		<section class="information-grid">
			<article class="information-card information-card--knowledge">
				<h2>Conocimientos</h2>

				<div class="knowledge-grid">
					<section class="knowledge-group">
						<h3>Desarrollo frontend</h3>

						<ul class="knowledge-list">
							<li>HTML</li>
							<li>CSS</li>
							<li>JavaScript</li>
							<li>TypeScript</li>
							<li>React</li>
							<li>Diseño responsive</li>
							<li>Componentización</li>
							<li>Consumo de APIs REST</li>
						</ul>
					</section>

					<section class="knowledge-group">
						<h3>Desarrollo backend y bases de datos</h3>

						<ul class="knowledge-list">
							<li>Python</li>
							<li>FastAPI</li>
							<li>SQL</li>
							<li>PostgreSQL</li>
							<li>Desarrollo de APIs REST</li>
							<li>Modelado de bases de datos relacionales</li>
							<li>Autenticación y gestión de sesiones</li>
							<li>Pruebas end-to-end</li>
							<li>Pruebas de carga y rendimiento</li>
							<li>Integración y despliegue continuo</li>
							<li>Medición de cobertura de código</li>
						</ul>
					</section>

					<section class="knowledge-group">
						<h3>Calidad y diseño de software</h3>

						<ul class="knowledge-list">
							<li>Pruebas funcionales</li>
							<li>Pruebas de regresión</li>
							<li>Diseño de casos de prueba</li>
							<li>Documentación de defectos</li>
							<li>Pruebas unitarias y de integración</li>
							<li>Diseño UX/UI</li>
							<li>Wireframes</li>
							<li>Prototipado</li>
							<li>Pruebas end-to-end</li>
							<li>Pruebas de carga y rendimiento</li>
							<li>Integración y despliegue continuo</li>
							<li>Medición de cobertura de código</li>
						</ul>
					</section>

					<section class="knowledge-group">
						<h3>Fundamentos de programación</h3>

						<ul class="knowledge-list">
							<li>C</li>
							<li>C++</li>
							<li>Programación orientada a objetos</li>
							<li>Estructuras de datos</li>
							<li>Algoritmos</li>
							<li>Resolución de problemas</li>
						</ul>
					</section>
					<section class="knowledge-group">
						<h3>Infraestructura y sistemas</h3>

						<ul class="knowledge-list">
							<li>Contenedores</li>
							<li>Procesamiento en segundo plano</li>
							<li>Colas de tareas</li>
							<li>Caché distribuida</li>
							<li>Monitoreo de servicios HTTP</li>
							<li>Gestión automática de incidentes</li>
						</ul>
					</section>
				</div>
			</article>

			<article class="information-card information-card--tools">
				<h2>Herramientas</h2>

				<div class="knowledge-grid">
					<section class="knowledge-group">
						<h3>Desarrollo</h3>

						<ul class="knowledge-list">
							<li>Git</li>
							<li>GitHub</li>
							<li>Visual Studio Code</li>
							<li>Redis</li>
							<li>Celery</li>
							<li>Docker</li>
							<li>GitHub Actions</li>
						</ul>
					</section>

					<section class="knowledge-group">
						<h3>Diseño</h3>

						<ul class="knowledge-list">
							<li>Figma</li>
						</ul>
					</section>

					<section class="knowledge-group">
						<h3>Pruebas</h3>

						<ul class="knowledge-list">
							<li>Pytest</li>
							<li>Vitest</li>
							<li>Testing Library</li>
							<li>Playwright</li>
							<li>k6</li>
						</ul>
					</section>
					<section class="knowledge-group">
						<h3>Infraestructura</h3>

						<ul class="knowledge-list">
							<li>Nginx</li>
							<li>Vercel</li>
							<li>Render</li>
							<li>Neon</li>
						</ul>
					</section>
					<section class="knowledge-group">
						<h3>Calidad de código</h3>

						<ul class="knowledge-list">
							<li>Ruff</li>
							<li>Oxlint</li>
						</ul>
					</section>
				</div>
			</article>

			<article class="information-card information-card--experience">
				<h2>Experiencia</h2>

				<div class="knowledge-grid">
					<section class="knowledge-group">
						<h3>JTECH</h3>

						<p class="experience-meta">
							<strong>UX/UI Designer Intern</strong>
							<span>Enero – diciembre 2024</span>
						</p>

						<ul class="knowledge-list">
							<li>
								Diseñé wireframes, interfaces y prototipos
								interactivos utilizando Figma.
							</li>
							<li>
								Apoyé en la definición de flujos de usuario y
								organización de contenido.
							</li>
							<li>
								Realicé ajustes de diseño con base en la
								retroalimentación del equipo.
							</li>
							<li>
								Colaboré con desarrolladores para facilitar la
								implementación de las interfaces.
							</li>
						</ul>
					</section>

					<section class="knowledge-group">
						<h3>SOFTM, Grupo Migesa</h3>

						<p class="experience-meta">
							<strong>Quality Assurance Intern</strong>
							<span>Enero 2025 – febrero 2026</span>
						</p>

						<ul class="knowledge-list">
							<li>
								Diseñé y ejecuté casos de prueba funcionales y
								de regresión para aplicaciones web.
							</li>
							<li>
								Validé flujos de inicio de sesión, contraseñas,
								permisos, tokens y bloqueo de usuarios.
							</li>
							<li>
								Documenté defectos con pasos de reproducción,
								evidencia y resultados esperados.
							</li>
							<li>
								Colaboré con desarrolladores para verificar
								correcciones y realizar pruebas de confirmación.
							</li>
							<li>
								Participé en la revisión de requerimientos para
								identificar posibles inconsistencias antes de
								las pruebas.
							</li>
						</ul>
					</section>
				</div>

				<section class="certificates">
					<h3>Certificados</h3>

					<ul class="knowledge-list certificates__list">
						<li>Learn Python 3 — Codecademy, 2024</li>
						<li>Diplomado de Formación de Líderes — FIME, 2023</li>
						<li>
							Advanced English – Level 9 — Hansa Language Centre,
							2017
						</li>
					</ul>
				</section>
			</article>
		</section>
	</main>

	<style>
		:global(body) {
			overflow-x: hidden;
			background: var(--color-dark);
		}

		.home-page {
			width: 100%;
			min-height: 100svh;
			margin: 0;
			padding: 0.5rem clamp(1rem, 2.5vw, 2.5rem)
				clamp(1rem, 2.5vw, 2.5rem);
			background: var(--color-dark);
			color: var(--color-white);
		}

		.main-nav {
			width: min(100%, 96rem);
			margin: 0 auto;
			padding: 0.65rem 1rem;

			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			gap: 1rem;

			background-color: color-mix(
				in srgb,
				var(--color-dark) 75%,
				#000000
			);
			border: 1px solid
				color-mix(in srgb, var(--color-white) 18%, transparent);
			border-radius: 1.25rem;
			box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 20%);
		}

		.main-nav__brand {
			display: inline-flex;
			align-items: center;
			gap: 0.75rem;
			justify-self: start;

			color: var(--color-white);
			text-decoration: none;
			white-space: nowrap;
		}

		.main-nav__brand-symbol {
			color: var(--color-green);
			font-size: 1.35rem;
		}

		.main-nav__links {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 1rem;
		}

		.main-nav__link {
			display: inline-flex;
			align-items: center;
			justify-content: center;

			padding: 0.65rem 1.2rem;
			color: var(--color-white);
			text-decoration: none;
			white-space: nowrap;
			border-radius: 0.75rem;
		}

		.main-nav__link--active {
			color: var(--color-dark);
			background-color: var(--color-green);
		}

		.main-nav__download {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			justify-self: end;

			padding: 0.65rem 1rem;
			color: var(--color-green);
			text-decoration: none;
			white-space: nowrap;

			border: 1px solid var(--color-green);
			border-radius: 0.75rem;
		}
		.home-intro {
			display: grid;
			grid-template-columns:
				minmax(12rem, 0.7fr)
				minmax(0, 1.7fr)
				minmax(15rem, 0.85fr);
			align-items: center;
			width: min(100%, 96rem);
			gap: clamp(2rem, 4vw, 5rem);
			margin: 1.5rem auto 0;
		}

		.profile {
			text-align: left;
		}

		.profile__avatar {
			display: block;
			width: clamp(8rem, 12vw, 10.5rem);
			aspect-ratio: 1;
			margin-inline: auto;
			border: 3px solid var(--color-green);
			border-radius: 50%;
			box-shadow: 0 0 1.5rem rgb(84 179 134 / 30%);
			object-fit: cover;
			object-position: center 45%;
		}

		.profile__availability {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.55rem;
			width: fit-content;
			margin: 1.25rem auto 0;
			padding: 0.65rem 0.85rem;
			border: 1px solid var(--color-green);
			border-radius: 20px;
			color: var(--color-green);
			font-size: clamp(0.55rem, 0.7vw, 0.7rem);
			line-height: 1.4;
			text-align: center;
		}

		.profile__availability span {
			flex: 0 0 auto;
			width: 0.6rem;
			aspect-ratio: 1;
			border-radius: 50%;
			background: var(--color-green);
		}

		.profile__role {
			display: grid;
			gap: 0.45rem;
			margin: 1.5rem 0 0;
			font-size: clamp(0.8rem, 1vw, 1rem);
			line-height: 1.45;
		}

		.profile__role strong {
			color: var(--color-green);
			font-weight: 400;
		}

		.profile__location {
			display: flex;
			align-items: flex-start;
			gap: 0.6rem;
			margin: 1rem 0 0;
			font-size: clamp(0.65rem, 0.8vw, 0.8rem);
			line-height: 1.5;
		}

		.profile__location-icon {
			flex: 0 0 auto;
			width: 1.15rem;
			height: 1.15rem;
			margin-top: 0.05rem;
			color: var(--color-green);
			stroke: currentColor;
			stroke-width: 2;
			stroke-linecap: round;
			stroke-linejoin: round;
		}

		.profile__languages {
			display: flex;
			align-items: flex-start;
			gap: 0.6rem;
			margin-top: 1.25rem;
			font-size: clamp(0.6rem, 0.75vw, 0.75rem);
			line-height: 1.5;
		}

		.profile__languages-icon {
			flex: 0 0 auto;
			width: 1.2rem;
			height: 1.2rem;
			margin-top: 0.05rem;
			color: var(--color-green);
			stroke: currentColor;
			stroke-width: 1.8;
			stroke-linecap: round;
			stroke-linejoin: round;
		}

		.profile__languages-list {
			display: grid;
			gap: 0.4rem;
		}

		.presentation {
			min-width: 0;
		}

		.presentation__heading {
			display: flex;
			align-items: center;
			gap: clamp(1.25rem, 2.5vw, 2.25rem);
		}

		.presentation__arrow {
			flex: 0 0 auto;
			width: 2.25rem;
			height: 2.25rem;
			border-top: 0.5rem solid var(--color-green);
			border-right: 0.5rem solid var(--color-green);
			transform: rotate(45deg);
		}

		.hello-world {
			flex: 0 0 auto;
			width: 11.4ch;
			margin: 0;
			overflow: hidden;
			border-right: 0.09em solid var(--color-white);
			font-size: clamp(2.4rem, 4vw, 4rem);
			font-weight: 400;
			line-height: 1.15;
			white-space: nowrap;
			animation:
				hello-typing 2s steps(11, end) 0.35s both,
				hello-cursor 0.7s step-end infinite;
		}

		.hello-world__message {
			color: var(--color-white);
		}

		.hello-world__accent {
			color: var(--color-green);
		}

		@keyframes hello-typing {
			from {
				width: 0;
			}

			to {
				width: 11.4ch;
			}
		}

		@keyframes hello-cursor {
			50% {
				border-color: transparent;
			}
		}

		.presentation__description {
			max-width: 48rem;
			margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
			color: var(--color-white);
			font-family: Arial, Helvetica, sans-serif;
			font-size: clamp(1rem, 1.25vw, 1.2rem);
			line-height: 1.75;
			text-align: left;
		}

		.presentation__description strong {
			color: var(--color-green);
			font-weight: 600;
		}

		.contact {
			display: grid;
			align-self: center;
			min-width: 0;
		}

		.contact__row {
			display: grid;
			grid-template-columns: 2.8rem minmax(0, 1fr);
			align-items: center;
			gap: 0.85rem;
			min-width: 0;
			padding: 1rem 0;
			border-bottom: 1px solid rgb(255 255 255 / 15%);
			color: var(--color-white);
			text-decoration: none;
		}

		.contact__icon {
			color: var(--color-green);
			font-family: Arial, Helvetica, sans-serif;
			font-size: 2rem;
			font-weight: 700;
			line-height: 1;
			text-align: center;
		}

		.contact__value {
			min-width: 0;
			color: var(--color-white);
			font-size: clamp(0.6rem, 0.75vw, 0.75rem);
			line-height: 1.5;
			overflow-wrap: anywhere;
		}

		.contact__row:hover .contact__value {
			color: var(--color-green);
		}

		.contact__icon--phone {
			position: relative;
			display: block;
			width: 1.4rem;
			height: 2.2rem;
			margin-inline: auto;
			border: 3px solid var(--color-green);
			border-radius: 5px;
		}

		.contact__icon--phone::before {
			content: "";
			position: absolute;
			top: 0.2rem;
			left: 50%;
			width: 0.45rem;
			height: 2px;
			border-radius: 2px;
			background: var(--color-green);
			transform: translateX(-50%);
		}

		.contact__icon--phone::after {
			content: "";
			position: absolute;
			bottom: 0.18rem;
			left: 50%;
			width: 0.35rem;
			height: 2px;
			border-radius: 2px;
			background: var(--color-green);
			transform: translateX(-50%);
		}

		.contact__icon--linkedin {
			font-size: 1.8rem;
			text-decoration: underline;
			text-underline-offset: 0.15em;
		}

		.contact__icon--github {
			width: 1.8rem;
			height: 1.8rem;
			margin-inline: auto;
			color: var(--color-green);
		}

		.information-grid {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			align-items: stretch;
			width: min(100%, 96rem);
			gap: clamp(1rem, 2vw, 1.5rem);
			margin: clamp(4rem, 7vw, 6rem) auto 0;
		}

		.information-card {
			--card-accent: var(--color-orange);

			min-width: 0;
			padding: clamp(1.25rem, 2vw, 2rem);
			border: 1px solid
				color-mix(in srgb, var(--card-accent) 35%, transparent);
			border-radius: 20px;
			background: color-mix(
				in srgb,
				var(--card-accent) 6%,
				var(--color-dark)
			);
			box-shadow: 0 1rem 2rem rgb(0 0 0 / 12%);
		}

		.information-card--knowledge {
			--card-accent: var(--color-orange);
		}

		.information-card--tools {
			--card-accent: var(--color-purple);
		}

		.information-card--experience {
			--card-accent: var(--color-blue);
		}

		.information-card > h2 {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			width: 100%;
			margin: 0;
			padding: 0 0 1.25rem;
