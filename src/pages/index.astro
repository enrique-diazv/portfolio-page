---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Enrique Díaz Vera | Portafolio"
	description="Portafolio de Enrique Díaz Vera, ingeniero en tecnología de software."
>
	<main class="home-page">
		<nav class="main-nav" aria-label="Navegación principal">
			<a class="main-nav__link main-nav__link--active" href="/"> Home </a>

			<a class="main-nav__link" href="/projects"> Projects </a>
		</nav>

		<section class="home-intro">
			<aside class="profile">
				<img
					class="profile__avatar"
					src="/images/IMG_8606.jpg"
					alt="Fotografía de Enrique Díaz Vera"
				/>

				<p class="profile__role">
					Ingeniero en Tecnología<br />
					de Software <br /><br />
					<small class="profile__languages">
						<span>Español: Nativo</span>
						<span>Inglés: B2/C1</span>
					</small>
				</p>
			</aside>

			<div class="presentation">
				<div class="presentation__heading">
					<span class="presentation__arrow" aria-hidden="true"></span>

					<p class="hello-world">
						<span class="hello-world__code">print(</span>
						<span class="hello-world__message"> Hola, Mundo </span>
						<span class="hello-world__code">)</span>
					</p>
				</div>

				<p class="presentation__description">
					<span>
						Mi nombre es Enrique Díaz Vera, desarrollador de
						software con formación en Ingeniería en Tecnología de
						Software por la Universidad Autónoma de Nuevo León,
						Facultad de Ingenieria Mecánica y Eléctrica. Recién he
						concluido los 10 semestres del plan de estudios y me
						encuentro en la etapa final de mi formación
						universitaria. Cuento con experiencia en Quality
						Assurance, diseño UX/UI y desarrollo de software.
					</span>
				</p>
			</div>

			<aside class="contact" aria-label="Datos de contacto">
				<a
					class="contact__row"
					href="mailto:ediazvera30@gmail.com"
					aria-label="Enviar correo a Enrique Díaz Vera"
				>
					<span class="contact__icon" aria-hidden="true">@</span>
					<span class="contact__value contact__value--email">
						ediazvera30@gmail.com
					</span>
				</a>

				<a
					class="contact__row"
					href="tel:+529384010427"
					aria-label="Llamar a Enrique Díaz Vera"
				>
					<span
						class="contact__icon contact__icon--phone"
						aria-hidden="true"
					>
					</span>
					<span class="contact__value">+52 938 401 0427</span>
				</a>

				<a
					class="contact__row"
					href="https://www.linkedin.com/in/enrique-d%C3%ADaz-vera"
					target="_blank"
					rel="noreferrer"
					aria-label="Visitar el LinkedIn de Enrique Díaz Vera"
				>
					<span
						class="contact__icon contact__icon--linkedin"
						aria-hidden="true"
					>
						in
					</span>
					<span class="contact__value">LinkedIn</span>
				</a>
			</aside>
		</section>

		<section class="information-grid">
			<article class="information-card">
				<h2>Conocimientos</h2>

				<div class="knowledge-grid">
					<section class="knowledge-group">
						<h3>Desarrollo frontend</h3>

						<ul class="knowledge-list">
							<li>HTML</li>
							<li>CSS</li>
							<li>JavaScript</li>
							<li>TypeScript</li>
							<li>React</li>
							<li>Diseño responsive</li>
							<li>Componentización</li>
							<li>Consumo de APIs REST</li>
						</ul>
					</section>

					<section class="knowledge-group">
						<h3>Desarrollo backend y bases de datos</h3>

						<ul class="knowledge-list">
							<li>Python</li>
							<li>FastAPI</li>
							<li>SQL</li>
							<li>PostgreSQL</li>
							<li>Desarrollo de APIs REST</li>
							<li>Modelado de bases de datos relacionales</li>
							<li>Autenticación y gestión de sesiones</li>
						</ul>
					</section>

					<section class="knowledge-group">
						<h3>Calidad y diseño de software</h3>

						<ul class="knowledge-list">
							<li>Pruebas funcionales</li>
							<li>Pruebas de regresión</li>
							<li>Diseño de casos de prueba</li>
							<li>Documentación de defectos</li>
							<li>Pruebas unitarias y de integración</li>
							<li>Diseño UX/UI</li>
							<li>Wireframes</li>
							<li>Prototipado</li>
						</ul>
					</section>

					<section class="knowledge-group">
						<h3>Fundamentos de programación</h3>

						<ul class="knowledge-list">
							<li>C</li>
							<li>C++</li>
							<li>Programación orientada a objetos</li>
							<li>Estructuras de datos</li>
							<li>Algoritmos</li>
							<li>Resolución de problemas</li>
						</ul>
					</section>
				</div>
			</article>

			<article class="information-card">
				<h2>Herramientas</h2>

				<div class="knowledge-grid">
					<section class="knowledge-group">
						<h3>Desarrollo</h3>

						<ul class="knowledge-list">
							<li>Git</li>
							<li>GitHub</li>
							<li>Visual Studio Code</li>
						</ul>
					</section>

					<section class="knowledge-group">
						<h3>Diseño</h3>

						<ul class="knowledge-list">
							<li>Figma</li>
							<li>Pytest</li>
							<li>Vitest</li>
							<li>Testing Library</li>
						</ul>
					</section>
				</div>
			</article>

			<article class="information-card">
				<h2>Experiencia</h2>

				<div class="knowledge-grid">
					<section class="knowledge-group">
						<h3>JTECH</h3>

						<p class="experience-meta">
							<strong>UX/UI Designer Intern</strong>
							<span>Enero – diciembre 2024</span>
						</p>

						<ul class="knowledge-list">
							<li>
								Diseñé wireframes, interfaces y prototipos
								interactivos utilizando Figma.
							</li>
							<li>
								Apoyé en la definición de flujos de usuario y
								organización de contenido.
							</li>
							<li>
								Realicé ajustes de diseño con base en la
								retroalimentación del equipo.
							</li>
							<li>
								Colaboré con desarrolladores para facilitar la
								implementación de las interfaces.
							</li>
						</ul>
					</section>

					<section class="knowledge-group">
						<h3>SOFTM, Grupo Migesa</h3>

						<p class="experience-meta">
							<strong>Quality Assurance Intern</strong>
							<span>Enero 2025 – febrero 2026</span>
						</p>

						<ul class="knowledge-list">
							<li>
								Diseñé y ejecuté casos de prueba funcionales y
								de regresión para aplicaciones web.
							</li>
							<li>
								Validé flujos de inicio de sesión, contraseñas,
								permisos, tokens y bloqueo de usuarios.
							</li>
							<li>
								Documenté defectos con pasos de reproducción,
								evidencia y resultados esperados.
							</li>
							<li>
								Colaboré con desarrolladores para verificar
								correcciones y realizar pruebas de confirmación.
							</li>
							<li>
								Participé en la revisión de requerimientos para
								identificar posibles inconsistencias antes de
								las pruebas.
							</li>
						</ul>
					</section>
				</div>

				<section class="certificates">
					<h2>Certificados</h2>

					<ul class="knowledge-list certificates__list">
						<li>Learn Python 3 — Codecademy, 2024</li>
						<li>Diplomado de Formación de Líderes — FIME, 2023</li>
						<li>
							Advanced English – Level 9 — Hansa Language Centre,
							2017
						</li>
					</ul>
				</section>
			</article>
		</section>
	</main>
</BaseLayout>

<style>
	:global(body) {
		overflow-x: hidden;
		background: var(--color-dark);
	}

	.home-page {
		width: 100%;
		min-height: 100svh;
		margin: 0;
		padding: clamp(1rem, 2.5vw, 2.5rem);
		background: var(--color-dark);
		color: var(--color-white);
	}

	.main-nav,
	.home-intro,
	.home-footer {
		width: min(100%, 96rem);
		margin-inline: auto;
	}

	.main-nav {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(2rem, 7vw, 6rem);
		width: min(100%, 96rem);
		min-height: clamp(3.2rem, 4vw, 3.75rem);
		margin-inline: auto;
		padding: 0.35rem 1rem;
		border-radius: 999px;
		background: var(--color-green);
	}
	.main-nav__link {
		padding: 0.18em 0.55em;
		border-radius: 0.6em;
		color: var(--color-white);
		font-size: clamp(1.2rem, calc(1rem + 0.6vw), 1.75rem);
		line-height: 1;
		text-decoration: none;
	}

	.main-nav__link--active {
		background: var(--color-dark);
		color: var(--color-orange);
	}

	.home-intro {
		display: grid;
		grid-template-columns:
			11rem
			minmax(0, 1fr)
			14rem;
		grid-template-rows: auto auto;
		align-items: start;
		column-gap: 2rem;
		row-gap: clamp(1.5rem, 2vw, 2.5rem);
		margin-top: 6rem;
	}

	.profile {
		display: contents;
	}

	.profile__avatar {
		display: block;
		grid-column: 1;
		grid-row: 1;
		align-self: center;
		width: clamp(7rem, 10vw, 8.5rem);
		aspect-ratio: 1;
		margin-inline: auto;
		border-radius: 50%;
		object-fit: cover;
		object-position: center 45%;
	}

	.profile__role,
	.profile__education {
		margin: 1.5rem 0 0;
		font-size: clamp(0.8rem, 1.25vw, 1rem);
		line-height: 1.25;
	}

	.profile__role {
		grid-column: 1;
		grid-row: 2;
		align-self: start;
		margin: 0;
		text-align: center;
	}

	.profile__languages {
		display: grid;
		gap: 0.25rem;
		margin-top: 1.25rem;
		font-size: 0.8rem;
		line-height: 1.3;
	}

	.profile__education strong {
		font-weight: 500;
	}

	.presentation {
		display: contents;
	}

	.presentation__heading {
		display: flex;
		grid-column: 2;
		grid-row: 1;
		align-items: center;
		align-self: center;
		gap: clamp(1.25rem, 3vw, 2.5rem);
	}

	.presentation__arrow {
		flex: 0 0 auto;
		width: 2.25rem;
		height: 2.25rem;
		border-top: 0.5rem solid var(--color-red);
		border-right: 0.5rem solid var(--color-red);
		transform: rotate(45deg);
	}

	.hello-world {
		flex: 0 0 auto;
		width: 15ch;
		margin: 0;
		overflow: hidden;
		border-right: 0.09em solid var(--color-white);
		font-size: clamp(2.5rem, calc(1.5rem + 2vw), 4rem);
		line-height: 1;
		white-space: nowrap;
		animation:
			hello-typing 2.4s steps(20, end) 0.35s both,
			hello-cursor 0.7s step-end infinite;
	}

	.hello-world__code {
		color: var(--color-orange);
		font-size: 0.55em;
	}

	.hello-world__message {
		color: var(--color-white);
	}

	@keyframes hello-typing {
		from {
			width: 0;
		}

		to {
			width: 15 ch;
		}
	}

	@keyframes hello-cursor {
		50% {
			border-color: transparent;
		}
	}

	.presentation__description {
		grid-column: 2;
		grid-row: 2;
		align-self: start;
		max-width: 100%;
		margin: 0;
		color: var(--color-dark);
		font-size: clamp(0.68rem, 0.8vw, 0.85rem);

		/* Separación entre los fondos verdes */
		line-height: 2.35;

		text-align: justify;
		text-align-last: left;
	}

	.presentation__description span {
		/* Espacio interior del fondo */
		padding: 0.3em 0.65em 0.4em;

		border-radius: 20px;
		background: var(--color-green);

		/* Altura del texto dentro del fondo */
		line-height: 1.3;

		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}
	.contact {
		display: grid;
		grid-column: 3;
		grid-row: 2;
		align-self: start;
		min-width: 0;
		gap: 1rem;
	}
	.contact__value--email {
		padding-inline: 0.4rem;
		font-size: clamp(0.52rem, 0.58vw, 0.7rem);
		white-space: nowrap;
	}

	.contact__row {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr);
		align-items: center;
		min-width: 0;
		gap: 0.75rem;
		color: inherit;
		text-decoration: none;
	}

	.contact__icon {
		color: var(--color-white);
		font-family: Arial, sans-serif;
		font-size: 2.8rem;
		font-weight: 700;
		line-height: 0.8;
		text-align: center;
	}

	.contact__value {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		min-width: 0;
		min-height: 2.6rem;
		padding: 0.4rem 0.7rem;
		border-radius: 20px;
		background: var(--color-green);
		color: var(--color-dark);
		font-size: clamp(0.65rem, 0.78vw, 0.85rem);
		line-height: 1.25;
		text-align: center;
		white-space: nowrap;
		text-decoration: none;
	}

	.contact__value.contact__value--email {
		padding-inline: 0.35rem;
		font-size: clamp(0.5rem, 0.55vw, 0.65rem);
		white-space: nowrap;
	}

	.contact__row:hover .contact__value {
		background: var(--color-orange);
	}

	.contact__icon--phone {
		position: relative;
		display: block;
		width: 1.65rem;
		height: 2.6rem;
		margin-inline: auto;
		border: 4px solid var(--color-white);
		border-radius: 6px;
		font-size: 0;
		line-height: normal;
	}

	.contact__icon--phone::before {
		content: "";
		position: absolute;
		top: 0.25rem;
		left: 50%;
		width: 0.55rem;
		height: 3px;
		border-radius: 2px;
		background: var(--color-white);
		transform: translateX(-50%);
	}

	.contact__icon--phone::after {
		content: "";
		position: absolute;
		bottom: 0.22rem;
		left: 50%;
		width: 0.45rem;
		height: 3px;
		border-radius: 2px;
		background: var(--color-white);
		transform: translateX(-50%);
	}

	.contact__icon--linkedin {
		font-size: 2.4rem;
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.information-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		width: min(100%, 87rem);
		gap: clamp(2rem, 5vw, 5rem);
		margin: clamp(5rem, 8vw, 7rem) auto 0;
		padding-inline: 0;
	}

	.information-card h2 {
		width: fit-content;
		margin: 0;
		padding: 0.2em 0.55em;
		border-radius: 0.55em;
		background: var(--color-orange);
		color: var(--color-white);
		font-size: clamp(1.2rem, 1.6vw, 1.75rem);
		font-weight: 500;
		line-height: 1;
		white-space: nowrap;
	}

	.information-card h2 small {
		font-size: 0.25em;
		font-weight: 400;
	}

	.knowledge-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		margin-top: 2rem;
	}

	.knowledge-group {
		min-width: 0;
	}

	.knowledge-group h3 {
		width: fit-content;
		max-width: 100%;
		margin: 0 0 1rem;
		padding: 0.35em 0.7em;
		border-radius: 20px;
		/* background: var(--color-green); */
		color: var(--color-orange);
		font-size: clamp(0.7rem, 0.9vw, 0.9rem);
		line-height: 1.4;
	}

	.knowledge-group .experience-meta {
		margin: 0 0 1rem;
		padding: 0;
		border-radius: 0;
		background: transparent;
		color: var(--color-white);
	}

	.knowledge-list {
		display: grid;
		gap: 0.55rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.knowledge-list li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
		padding: 0.5rem 0 rem;
		border-radius: 20px;
		/* background: var(--color-green); */
		color: var(--color-white);
		font-size: clamp(0.65rem, 0.75vw, 0.8rem);
		line-height: 1.4;
	}

	.knowledge-list li::before {
		content: "·";
		flex: 0 0 auto;
		font-size: 1.25em;
		font-weight: bold;
	}

	.experience-meta {
		display: grid;
		gap: 0.45rem;
		margin: 0 0 1rem;
		color: var(--color-white);
		font-size: clamp(0.65rem, 0.75vw, 0.8rem);
		line-height: 1.5;
	}

	.experience-meta strong {
		color: var(--color-white);
		font-weight: 500;
	}

	.experience-meta span {
		color: var(--color-blue);
	}

	.certificates {
		margin-top: 3rem;
	}

	.certificates > h2 {
		margin-bottom: 1.5rem;
	}

	.certificates__list li {
		align-items: flex-start;
	}

	.placeholder-lines {
		display: grid;
		gap: 0.55rem;
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}

	.placeholder-lines li {
		height: 1rem;
		background: var(--color-green);
	}

	.home-footer {
		margin-top: clamp(5rem, 10vw, 8rem);
		font-size: clamp(0.85rem, 1.3vw, 1rem);
	}

	@media (max-width: 70rem) {
		.home-intro {
			grid-template-columns: 10rem minmax(0, 1fr);
			grid-template-rows: auto auto auto;
		}

		.contact {
			grid-column: 2;
			grid-row: 3;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			width: 100%;
		}

		.contact__value {
			white-space: normal;
			overflow-wrap: anywhere;
		}

		.information-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 45rem) {
		.knowledge-grid {
			grid-template-columns: 1fr;
		}

		.knowledge-group h3 {
			font-size: 0.85rem;
		}

		.home-page {
			padding: 1.25rem;
		}

		.main-nav {
			gap: 1.25rem;
		}

		.home-intro {
			grid-template-columns: 1fr;
			grid-template-rows: auto;
			gap: 3rem;
			margin-top: 4rem;
		}

		.profile {
			display: grid;
			grid-template-columns: 6.5rem 1fr;
			align-items: center;
			column-gap: 1.5rem;
			text-align: left;
		}

		.profile__avatar {
			grid-column: 1;
			grid-row: 1;
			position: relative;
			width: 7rem;
			aspect-ratio: 1;
			margin-inline: auto;
			border: 0.6rem solid #5b5b5b;
			border-radius: 50%;
			background: var(--color-white);
			overflow: hidden;
		}

		.profile__role,
		.profile__education {
			margin: 1.25rem 0 0;
			font-size: 0.68rem;
			line-height: 1.35;
		}

		.profile__role {
			grid-column: 2;
			grid-row: 1;
			margin: 0;
			text-align: left;
		}

		.profile__education {
			margin-top: 0.75rem;
		}

		.presentation {
			display: block;
		}

		.presentation__heading {
			gap: 1rem;
		}

		.presentation__arrow {
			flex: 0 0 auto;
			width: 1.75rem;
			height: 1.75rem;
		}

		.hello-world {
			width: 17ch;
			max-width: 100%;
			font-size: clamp(1.35rem, 7vw, 2.2rem);
			white-space: nowrap;
		}

		.presentation__description {
			margin-top: 2rem;
		}

		.contact {
			grid-column: 1;
			grid-row: auto;
			grid-template-columns: 1fr;
			width: 100%;
		}
		.information-grid {
			grid-template-columns: 1fr;
		}
		.information-card h2 {
			font-size: 1.8rem;
		}

		.home-footer {
			margin-top: 5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hello-world {
			width: 17ch;
			border-right: 0;
			animation: none;
		}
	}
</style>
